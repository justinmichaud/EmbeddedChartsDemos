{
  "name": "wasm-charts",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "wasm:build": "PATH=\"$HOME/.cargo/bin:$PATH\" wasm-pack build crates/charts --target web --out-dir ../../src/wasm --no-pack",
    "predev": "PATH=\"$HOME/.cargo/bin:$PATH\" wasm-pack build crates/charts --target web --out-dir ../../src/wasm --no-pack",
    "dev": "vite",
    "prebuild": "PATH=\"$HOME/.cargo/bin:$PATH\" wasm-pack build crates/charts --target web --out-dir ../../src/wasm --no-pack",
    "build": "vite build --base=\"/EmbeddedChartsDemos/\"",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "vite": "6.3.5"
  }
}
